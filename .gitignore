npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# local model experiments
.model-cache/


# generated native folders
/ios
/android

# firebase local artifacts
.env
functions/.env
firebase/native/google-services*.json
firebase/native/GoogleService-Info*.plist
firebase/native/*/google-services*.json
firebase/native/*/GoogleService-Info*.plist
.firebase-cli-home/
.emulator-data/
firebase-debug.log
firestore-debug.log
database-debug.log
ui-debug.log

# local assistant/editor state
.claude/
.agents/
.tmp/
# Throwaway debug copies of the project. These are FULL working copies —
# .tmp-staging-emulator-debug alone is 731 MB and carries its own .env, so a
# stray `git add -A` would commit both the bulk and the secrets.
.tmp-*/

# local emulator screenshots and scratch files
/together-*.png
/Ort

# private desktop-installer artifacts
/admin/desktop/release/

# JVM crash dumps (Android emulator / Java tooling)
hs_err_pid*.log
replay_pid*.log
# Metro bundler log
metro.log
.rollback/

# Debug-Screenshots aus Emulator-Sitzungen (Wegwerfmaterial, ~52 MB)
.artifacts/

# Firebase-Hosting-Deploy-Cache
.firebase/

# Next.js-Build-Ausgabe der Landingpage (~150 MB)
landing/.next/
landing/out/
