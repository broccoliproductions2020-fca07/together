{
  "expo": {
    "name": "Together",
    "slug": "together",
    "owner": "broccoli-studios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "together",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.ossabossa.together",
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.ossabossa.together",
      "adaptiveIcon": {
        "backgroundColor": "#070910",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070910",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 144
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-task-manager",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Together braucht Zugriff auf deine Fotos, damit du ein Profilbild auswählen kannst."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Together zeigt dir Freunde und Aktivitäten in deiner Nähe.",
          "locationAlwaysAndWhenInUsePermission": "Together nutzt deinen Standort im Hintergrund nur, wenn du eine Anreise oder deinen Heimweg ausdrücklich teilst. Die Freigabe endet automatisch oder sobald du sie beendest.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d534c243-7485-4d28-b030-454eb651d5ec"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d534c243-7485-4d28-b030-454eb651d5ec"
    }
  }
}
