{
  "expo": {
    "name": "Mica",
    "slug": "together",
    "platforms": ["ios", "android"],
    "owner": "broccoli-studios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["mica", "together", "mica"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "com.broccolistudio.together",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.broccolistudio.together",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070910",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 144
        }
      ],
      "expo-font",
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mica braucht Zugriff auf deine Fotos, damit du ein Profilbild auswählen kannst.",
          "cameraPermission": "Mica braucht Zugriff auf deine Kamera, damit du ein Profilbild aufnehmen kannst.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mica zeigt dir Freunde und Aktivitäten in deiner Nähe.",
          "locationAlwaysAndWhenInUsePermission": "Mica nutzt deinen Standort im Hintergrund nur, wenn du eine Anreise oder deinen Heimweg ausdrücklich teilst. Die Freigabe endet automatisch oder sobald du sie beendest.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d534c243-7485-4d28-b030-454eb651d5ec"
      },
      "internalVersion": "0.4.07"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d534c243-7485-4d28-b030-454eb651d5ec",
      "fallbackToCacheTimeout": 10000
    }
  }
}
