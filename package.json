{
  "name": "together",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/schibsted-grotesk": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "26.3.2",
    "@react-native-firebase/app-check": "26.3.2",
    "@react-native-firebase/auth": "26.3.2",
    "@react-native-firebase/crashlytics": "26.3.2",
    "@react-native-firebase/database": "26.3.2",
    "@react-native-firebase/firestore": "26.3.2",
    "@react-native-firebase/functions": "26.3.2",
    "@react-native-firebase/storage": "26.3.2",
    "@react-native-google-signin/google-signin": "16.1.4",
    "expo": "57.0.19",
    "expo-apple-authentication": "~57.0.1",
    "expo-build-properties": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.15",
    "expo-image-picker": "~57.0.15",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.15",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.15",
    "expo-updates": "~57.0.21",
    "firebase": "12.17.1",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-maps": "1.28.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "suncalc": "^2.0.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "~19.2.4",
    "@types/suncalc": "^1.9.2",
    "@xenova/transformers": "^2.17.2",
    "cross-env": "^10.1.0",
    "electron": "^41.10.6",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "expo-dev-client": "57.0.18",
    "firebase-tools": "^15.28.1",
    "prettier": "^3.9.6",
    "sharp": "^0.32.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "cross-env APP_VARIANT=development EXPO_PUBLIC_FIREBASE_EMULATORS=true EXPO_PUBLIC_FIREBASE_APP_CHECK_ENABLED=false EXPO_PUBLIC_CRASH_REPORTING_ENABLED=false EXPO_LOCAL_DEV=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --dev-client",
    "android": "npm run android:launch",
    "android:local": "npm run android:launch",
    "android:devclient": "npm run android:build && npm run android:launch",
    "android:launch": "powershell -ExecutionPolicy Bypass -File scripts/launch-android-devclient.ps1",
    "emulator": "powershell -ExecutionPolicy Bypass -File scripts/start-android-emulator.ps1",
    "ios": "cross-env APP_VARIANT=development EXPO_PUBLIC_FIREBASE_EMULATORS=true EXPO_PUBLIC_FIREBASE_APP_CHECK_ENABLED=false EXPO_PUBLIC_CRASH_REPORTING_ENABLED=false EXPO_LOCAL_DEV=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --dev-client --ios",
    "emulators": "node scripts/emulators.js",
    "emulators:persist": "node scripts/emulators.js --import ./.emulator-data --export-on-exit",
    "emulators:seed": "node scripts/seed-emulators.mjs && node scripts/seed-time-plan.mjs && node scripts/seed-heimweg.mjs --once",
    "emulators:test-mode": "npm run emulators:seed",
    "emulators:seed:heimweg": "node scripts/seed-heimweg.mjs",
    "emulators:seed:landing": "npm run screens:world",
    "test:journey-rtdb": "node scripts/firebase-emulators-exec.js",
    "test:firestore-rules": "node scripts/firebase-firestore-emulators-exec.js",
    "test:storage-rules": "node scripts/firebase-storage-emulators-exec.js",
    "test:functions": "node scripts/firebase-functions-emulators-exec.js",
    "backfill:activity-visible-until": "node scripts/backfill-activity-visible-until.mjs",
    "backfill:friend-search": "node scripts/backfill-friend-search.mjs",
    "test:activity-backfill": "node scripts/firebase-firestore-emulators-exec.js node scripts/test-activity-backfill.mjs",
    "test:email-verification-gate": "node scripts/firebase-email-verification-gate-exec.js",
    "test:core-selection": "node scripts/test-core-selection.mjs",
    "test:friend-search": "node scripts/test-friend-search.mjs",
    "check:node": "node scripts/check-node-version.cjs",
    "legal:html": "node scripts/generate-legal-html.mjs",
    "update:development": "cross-env APP_VARIANT=development EXPO_PUBLIC_FIREBASE_EMULATORS=true EXPO_PUBLIC_CRASH_REPORTING_ENABLED=false npx --yes eas-cli@22.2.0 update --channel development --environment development --platform ios",
    "update:staging": "npm run verify:release && cross-env APP_VARIANT=staging EXPO_PUBLIC_FIREBASE_EMULATORS=false EXPO_PUBLIC_FIREBASE_APP_CHECK_ENABLED=true EXPO_PUBLIC_CRASH_REPORTING_ENABLED=true EXPO_PUBLIC_STAGING_DIAGNOSTICS=true npx --yes eas-cli@22.2.0 update --channel staging --environment preview --platform ios --non-interactive",
    "update:production": "node scripts/release-guard.cjs && npm run verify:release && cross-env APP_VARIANT=production EXPO_PUBLIC_FIREBASE_EMULATORS=false EXPO_PUBLIC_FIREBASE_APP_CHECK_ENABLED=true EXPO_PUBLIC_CRASH_REPORTING_ENABLED=true npx --yes eas-cli@22.2.0 update --channel production --environment production --platform ios --non-interactive",
    "test:activity-understanding": "node scripts/evaluate-activity-embeddings.mjs Xenova/multilingual-e5-small",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "lint:src": "eslint src",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:hosting:prod": "firebase deploy --project prod --only hosting",
    "deploy:rules:dev": "firebase deploy --project dev --only firestore:rules,firestore:indexes,database,storage",
    "deploy:rules:prod": "firebase deploy --project prod --only firestore:rules,firestore:indexes,database,storage",
    "preflight:functions:dev": "node scripts/functions-deploy-safety.cjs --project dev",
    "preflight:functions:prod": "node scripts/functions-deploy-safety.cjs --project prod",
    "deploy:functions:dev": "node scripts/functions-deploy-safety.cjs --project dev --deploy",
    "deploy:functions:prod": "node scripts/functions-deploy-safety.cjs --project prod --deploy",
    "deploy:functions:timers:dev": "node scripts/functions-deploy-safety.cjs --project dev --only maintainRuntime,scheduleJourneyReminder,dispatchJourneyReminder,scheduleSafetyAutoExtend,dispatchSafetyAutoExtend --force --deploy",
    "deploy:functions:timers:prod": "node scripts/functions-deploy-safety.cjs --project prod --only maintainRuntime,scheduleJourneyReminder,dispatchJourneyReminder,scheduleSafetyAutoExtend,dispatchSafetyAutoExtend --force --deploy",
    "test:safety-task": "node scripts/firebase-functions-emulators-exec.js \"node scripts/test-safety-task.js\"",
    "deploy:functions:poi:dev": "node scripts/functions-deploy-safety.cjs --project dev --only places --deploy",
    "deploy:functions:email:dev": "node scripts/functions-deploy-safety.cjs --project dev --only sendVerificationEmail,deliverEmailOutbox --deploy",
    "deploy:functions:email:prod": "node scripts/functions-deploy-safety.cjs --project prod --only sendVerificationEmail,deliverEmailOutbox --deploy",
    "deploy:functions:push:dev": "node scripts/functions-deploy-safety.cjs --project dev --only deliverPushOutbox --deploy",
    "deploy:functions:push:prod": "node scripts/functions-deploy-safety.cjs --project prod --only deliverPushOutbox --deploy",
    "deploy:functions:friends:dev": "node scripts/functions-deploy-safety.cjs --project dev --only sendFriendRequest,respondToFriendRequest,withdrawFriendRequest --deploy",
    "deploy:functions:friends:prod": "node scripts/functions-deploy-safety.cjs --project prod --only sendFriendRequest,respondToFriendRequest,withdrawFriendRequest --deploy",
    "deploy:dev": "npm run preflight:functions:dev && npm run deploy:rules:dev && npm run deploy:functions:dev",
    "deploy:prod": "node scripts/release-guard.cjs && npm run verify:release && npm run preflight:functions:prod && npm run deploy:rules:prod && npm run deploy:functions:prod",
    "verify:release": "npm run check:node && npm run typecheck && npm run lint:src && npm run test:invite-link && npm run test:button-contrast && npm run test:firestore-rules && npm run test:storage-rules && npm run test:journey-rtdb && npm run test:activity-backfill && npm run test:functions && npm run test:safety-task && npm run test:email-verification-gate",
    "build:staging": "eas build --profile staging --platform all",
    "build:production": "eas build --profile production --platform all",
    "android:build": "powershell -ExecutionPolicy Bypass -File scripts/build-android-devclient.ps1",
    "dashboard": "node admin/local-dashboard.cjs",
    "dashboard:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item Env:ELECTRON_RUN_AS_NODE -ErrorAction SilentlyContinue; & .\\node_modules\\.bin\\electron.cmd admin\\desktop\\main.cjs\"",
    "dashboard:desktop:package": "electron-builder --win nsis",
    "test:audience-selection": "node scripts/test-audience-selection.mjs",
    "test:invite-link": "node scripts/test-invite-link.mjs",
    "test:time-range-picker": "node scripts/test-time-range-picker.mjs",
    "test:time-planning": "node scripts/test-time-planning.mjs",
    "test:time-plan-functions": "node scripts/firebase-functions-emulators-exec.js \"node scripts/test-time-plan-functions.js\"",
    "test:marker-countdown": "node scripts/test-marker-countdown.mjs",
    "screens:world": "node scripts/seed-emulators.mjs --scenario landing --me open && node scripts/seed-time-plan.mjs --scenario landing",
    "screens:world:berlin": "node scripts/seed-emulators.mjs --scenario landing --lat 52.5208 --lng 13.4095 --me idle && node scripts/seed-time-plan.mjs --scenario landing --lat 52.5208 --lng 13.4095",
    "screens:world:berlin-time": "node scripts/seed-emulators.mjs --scenario landing --lat 52.5208 --lng 13.4095 --me idle && node scripts/seed-time-plan.mjs --scenario landing --lat 52.5208 --lng 13.4095 && node scripts/prepare-capture-device.mjs --lat 52.516758 --lng 13.4095",
    "screens:world:berlin-soon": "node scripts/seed-emulators.mjs --lat 52.5208 --lng 13.4095 --me idle && node scripts/prepare-capture-device.mjs --lat 52.5168 --lng 13.4135",
    "screens:world:berlin-open": "node scripts/seed-emulators.mjs --scenario landing --lat 52.5208 --lng 13.4095 --me open && node scripts/seed-time-plan.mjs --scenario landing --lat 52.5208 --lng 13.4095",
    "screens:world:map": "node scripts/seed-emulators.mjs --scenario landing --me idle && node scripts/seed-time-plan.mjs --scenario landing",
    "screens:world:anreise": "node scripts/seed-emulators.mjs --scenario landing --me idle && node scripts/seed-time-plan.mjs --scenario landing && node scripts/seed-journey.mjs --activity seed-act-lauf --viewer seed-mia --minutes 40",
    "screens:world:heimweg": "node scripts/seed-emulators.mjs --scenario landing --me idle && node scripts/seed-time-plan.mjs --scenario landing && node scripts/seed-heimweg.mjs --once --scenario landing --owner seed-mia --audience seed-amelie,seed-david",
    "screens:device": "node scripts/prepare-capture-device.mjs",
    "screens:metro": "cross-env EXPO_PUBLIC_QUIET_MAP=1 expo start --dev-client",
    "screens:verify": "node scripts/verify-landing-world.mjs",
    "screens:capture": "node scripts/capture-screens.mjs",
    "screens:render": "node scripts/render-landing-screen.mjs",
    "screens:list": "node scripts/capture-screens.mjs --list",
    "screens:ui": "node scripts/capture-screens.mjs --ui",
    "test:screen-recipes": "node scripts/test-screen-recipes.mjs",
    "test:button-contrast": "node scripts/test-button-contrast.mjs"
  },
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "build": {
    "appId": "com.broccolistudio.together.operations",
    "productName": "Mica Betrieb",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "admin/desktop/release"
    },
    "files": [
      "admin/desktop/**/*",
      "!admin/desktop/release{,/**}",
      "admin/local-dashboard.cjs",
      "admin/public/**/*",
      "scripts/firebase-admin-tools.cjs",
      "functions/package.json",
      "functions/node_modules/**/*",
      "!node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "admin/desktop/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mica Betrieb"
    }
  },
  "expo": {}
}
