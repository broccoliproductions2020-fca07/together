{
  "name": "together",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/schibsted-grotesk": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/app-check": "^25.1.0",
    "@react-native-firebase/auth": "^25.1.0",
    "@react-native-firebase/crashlytics": "^25.1.0",
    "@react-native-firebase/database": "^25.1.0",
    "@react-native-firebase/firestore": "^25.1.0",
    "@react-native-firebase/functions": "^25.1.0",
    "@react-native-firebase/storage": "^25.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "expo": "~54.0.36",
    "expo-apple-authentication": "~8.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.19",
    "firebase": "^12.15.0",
    "nativewind": "^5.0.0-preview.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css": "^3.0.7",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-maps": "1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-worklets": "0.5.1",
    "suncalc": "^2.0.1"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/react": "~19.1.10",
    "@types/suncalc": "^1.9.2",
    "@xenova/transformers": "^2.17.2",
    "cross-env": "^10.1.0",
    "eas-cli": "21.4.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "expo-dev-client": "~6.0.21",
    "firebase-tools": "^15.22.4",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "cross-env APP_VARIANT=development EXPO_PUBLIC_FIREBASE_EMULATORS=true EXPO_PUBLIC_FIREBASE_APP_CHECK_ENABLED=false EXPO_PUBLIC_CRASH_REPORTING_ENABLED=false EXPO_LOCAL_DEV=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --dev-client",
    "android": "npm run android:launch",
    "android:local": "npm run android:launch",
    "android:devclient": "npm run android:build && npm run android:launch",
    "android:launch": "powershell -ExecutionPolicy Bypass -File scripts/launch-android-devclient.ps1",
    "emulator": "powershell -ExecutionPolicy Bypass -File scripts/start-android-emulator.ps1",
    "ios": "cross-env APP_VARIANT=development EXPO_PUBLIC_FIREBASE_EMULATORS=true EXPO_PUBLIC_FIREBASE_APP_CHECK_ENABLED=false EXPO_PUBLIC_CRASH_REPORTING_ENABLED=false EXPO_LOCAL_DEV=1 EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --dev-client --ios",
    "emulators": "node scripts/emulators.js",
    "emulators:persist": "node scripts/emulators.js --import ./.emulator-data --export-on-exit",
    "emulators:seed": "node scripts/seed-emulators.mjs && node scripts/seed-heimweg.mjs --once",
    "emulators:seed:heimweg": "node scripts/seed-heimweg.mjs",
    "test:journey-rtdb": "node scripts/firebase-emulators-exec.js",
    "test:firestore-rules": "node scripts/firebase-firestore-emulators-exec.js",
    "test:storage-rules": "node scripts/firebase-storage-emulators-exec.js",
    "test:functions": "node scripts/firebase-functions-emulators-exec.js",
    "backfill:activity-visible-until": "node scripts/backfill-activity-visible-until.mjs",
    "test:activity-backfill": "node scripts/firebase-firestore-emulators-exec.js node scripts/test-activity-backfill.mjs",
    "test:email-verification-gate": "node scripts/firebase-email-verification-gate-exec.js",
    "check:node": "node scripts/check-node-version.cjs",
    "legal:html": "node scripts/generate-legal-html.mjs",
    "update:development": "cross-env APP_VARIANT=development EXPO_PUBLIC_FIREBASE_EMULATORS=true EXPO_PUBLIC_CRASH_REPORTING_ENABLED=false eas update --channel development --environment development --platform all",
    "update:staging": "npm run verify:release && eas update --channel staging --environment preview --platform all --non-interactive",
    "update:production": "node scripts/release-guard.cjs && npm run verify:release && eas update --channel production --environment production --platform all --non-interactive",
    "test:activity-understanding": "node scripts/evaluate-activity-embeddings.mjs Xenova/multilingual-e5-small",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "lint:src": "eslint src",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:rules:dev": "firebase deploy --project dev --only firestore:rules,firestore:indexes,database,storage",
    "deploy:rules:prod": "firebase deploy --project prod --only firestore:rules,firestore:indexes,database,storage",
    "preflight:functions:dev": "node scripts/functions-deploy-safety.cjs --project dev",
    "preflight:functions:prod": "node scripts/functions-deploy-safety.cjs --project prod",
    "deploy:functions:dev": "node scripts/functions-deploy-safety.cjs --project dev --deploy",
    "deploy:functions:prod": "node scripts/functions-deploy-safety.cjs --project prod --deploy",
    "deploy:functions:poi:dev": "node scripts/functions-deploy-safety.cjs --project dev --only autocompletePlaces,resolvePlaceLocation --deploy",
    "deploy:dev": "npm run preflight:functions:dev && npm run deploy:rules:dev && npm run deploy:functions:dev",
    "deploy:prod": "node scripts/release-guard.cjs && npm run verify:release && npm run preflight:functions:prod && npm run deploy:rules:prod && npm run deploy:functions:prod",
    "verify:release": "npm run check:node && npm run typecheck && npm run lint:src && npm run test:firestore-rules && npm run test:storage-rules && npm run test:journey-rtdb && npm run test:activity-backfill && npm run test:functions && npm run test:email-verification-gate",
    "build:staging": "eas build --profile staging --platform all",
    "build:production": "eas build --profile production --platform all",
    "android:build": "powershell -ExecutionPolicy Bypass -File scripts/build-android-devclient.ps1",
    "dashboard": "node admin/local-dashboard.cjs",
    "dashboard:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item Env:ELECTRON_RUN_AS_NODE -ErrorAction SilentlyContinue; & .\\node_modules\\.bin\\electron.cmd admin\\desktop\\main.cjs\"",
    "dashboard:desktop:package": "electron-builder --win nsis"
  },
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "build": {
    "appId": "com.broccolistudio.together.operations",
    "productName": "Together Betrieb",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "admin/desktop/release"
    },
    "files": [
      "admin/desktop/**/*",
      "!admin/desktop/release{,/**}",
      "admin/local-dashboard.cjs",
      "admin/public/**/*",
      "scripts/firebase-admin-tools.cjs",
      "functions/package.json",
      "functions/node_modules/**/*",
      "!node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "admin/desktop/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Together Betrieb"
    }
  }
}
