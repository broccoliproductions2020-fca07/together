rules_version = '2';

// Together — Firestore Security Rules.
//
// Principles (see docs/backend-plan.md):
//  - Default-deny: everything not explicitly allowed is denied.
//  - Membership checks read array fields on the document itself (no get()
//    cascades in hot paths; one parent get() only for message subcollections).
//  - Every write is size- and shape-limited → no unbounded documents, no
//    cost/DoS traps via oversized payloads or runaway arrays.
//  - Nothing is client-deletable; cleanup happens via TTL policies (expireAt).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    // NOTE: no keys().hasAll()/`is list` guards here — those are unprovable for
    // LIST queries (they'd silently deny every listener). `in` on a missing or
    // non-list field evaluates to an error → rule is false, so this stays safe.
    function isMember(data) {
      return signedIn()
        && request.auth.uid in data.memberIds;
    }
    // Avatar URLs must point at OUR storage (or the local emulator) — a free
    // string would let any accepted friend plant a tracking pixel that leaks
    // the viewers' IP addresses to an arbitrary server.
    function validAvatarUrl(url, uid) {
      return signedIn()
        && url is string
        && url.size() <= 500
        && (url.matches(
              'https://firebasestorage[.]googleapis[.]com/v0/b/'
                + request.auth.token.aud
                + '[.](appspot[.]com|firebasestorage[.]app)/o/avatars%2F'
                + uid + '(%2F[a-f0-9]{32})?[.]jpg[?].*'
            )
            || url.matches(
              'http://(127[.]0[.]0[.]1|localhost|10[.]0[.]2[.]2)(:[0-9]+)?/v0/b/'
                + request.auth.token.aud
                + '[.](appspot[.]com|firebasestorage[.]app)/o/avatars%2F'
                + uid + '(%2F[a-f0-9]{32})?[.]jpg[?].*'
            ));
    }

    // Default: deny.
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- users/{uid} ----------
    // Private account state. Full profile data is friends-only and is resolved
    // by trusted callables; push tokens and close-friend state never leave this
    // document.
    match /users/{uid} {
      function validUser(data) {
        return data.keys().hasOnly([
            'displayName', 'username', 'initials', 'avatarUrl', 'createdAt', 'pushTokens',
            'closeFriendUids', 'heimwegGroupUids', 'profileVisibility', 'friendRequestPolicy',
            'journeyRemindersEnabled', 'friendshipsVersion', 'notificationsSeenAt'
          ])
          && data.displayName is string
          && data.displayName.size() <= 50
          && data.username is string
          && data.username.size() <= 30
          // pushTokens/journeyRemindersEnabled are written by trusted callables
          // (Admin SDK). Updates validate the WHOLE future document, so these
          // server-owned fields must stay ALLOWED here — forbidding them would
          // deny every client profile update once the server has set one.
          && (!('pushTokens' in data)
              || (data.pushTokens is list && data.pushTokens.size() <= 10))
          && (!('journeyRemindersEnabled' in data) || data.journeyRemindersEnabled is bool)
          && (!('friendshipsVersion' in data)
              || (data.friendshipsVersion is int && data.friendshipsVersion >= 0))
          && (!('notificationsSeenAt' in data) || data.notificationsSeenAt is timestamp)
          && (!('avatarUrl' in data) || validAvatarUrl(data.avatarUrl, uid))
          && (!('closeFriendUids' in data)
              || (data.closeFriendUids is list && data.closeFriendUids.size() <= 200))
          // The Heimweg group is the preselected audience for "Sicher nach
          // Hause". Capped far below closeFriendUids on purpose: a live
          // location that goes to everyone helps nobody, because a request
          // addressed to a crowd makes no single person feel responsible.
          && (!('heimwegGroupUids' in data)
              || (data.heimwegGroupUids is list && data.heimwegGroupUids.size() <= 20))
          // Old documents are supported until their next trusted profile write.
          && (!('profileVisibility' in data) || data.profileVisibility == 'friends')
          && (!('friendRequestPolicy' in data)
              || data.friendRequestPolicy in ['anyone', 'shared_activity', 'nobody']);
      }

      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && validUser(request.resource.data)
        && (!('notificationsSeenAt' in request.resource.data)
            || request.resource.data.notificationsSeenAt == request.time);
      allow update: if signedIn()
        && request.auth.uid == uid
        && validUser(request.resource.data)
        && request.resource.data.username == resource.data.username
        // Profile, avatar, close-friend and Heimweg changes all go through
        // trusted callables. That is where upload ownership and profile-change
        // rate limits are enforced; allowing a direct document update here
        // would bypass both protections.
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['notificationsSeenAt'])
        && request.resource.data.notificationsSeenAt == request.time
        && (!('notificationsSeenAt' in resource.data)
            || request.resource.data.notificationsSeenAt > resource.data.notificationsSeenAt);
      allow delete: if false;
    }

    match /publicProfiles/{uid} {
      function validPublicProfile(data) {
        return data.keys().hasOnly([
            'displayName', 'username', 'initials', 'avatarUrl', 'createdAt'
          ])
          && data.displayName is string && data.displayName.size() <= 50
          && data.username is string && data.username.size() <= 30
          && data.initials is string && data.initials.size() <= 8
          && (!('avatarUrl' in data) || validAvatarUrl(data.avatarUrl, uid))
          && data.createdAt is timestamp;
      }

      // The client never gets a globally readable profile directory. Contextual
      // contact cards are resolved through trusted callables instead.
      allow read: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && validPublicProfile(request.resource.data);
      // Unlike displayName/initials/avatarUrl, username and createdAt must
      // stay fixed after creation — username has its own claim transaction,
      // and createdAt is an identity fact, not an editable profile field.
      allow update: if false;
      allow delete: if false;
    }

    // Private server-side search index. It is intentionally not a profile
    // directory: the callable applies discoverability, rate and block checks
    // before returning at most five minimal identity cards.
    match /friendSearch/{uid} {
      allow read, write: if false;
    }

    // ---------- circles/{circleId} ----------
    // Circles ARE the friendship model. Members read; ONLY the owner mutates
    // membership (adds by username) — nobody can add themselves to a circle.
    // ---------- friendships/{friendshipId} ----------
    // Requests and acceptance are callable-only. A participant may read their
    // own relationship, and no client can forge a friendship document.
    match /friendships/{friendshipId} {
      // Provable-for-lists (see isMember note above).
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantUids;
      allow create, update, delete: if false;
    }

    // ---------- users/{uid}/privateCircles/{circleId} ----------
    // Personal shortcut lists: only their owner can ever read their contents.
    match /users/{uid}/privateCircles/{circleId} {
      function validPrivateCircle(data) {
        return data.keys().hasOnly(['name', 'emoji', 'friendUids', 'createdAt', 'updatedAt'])
          && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
          && (!('emoji' in data) || (data.emoji is string && data.emoji.size() <= 8))
          && data.friendUids is list && data.friendUids.size() <= 50
          && data.createdAt is timestamp && data.updatedAt is timestamp;
      }
      allow read: if signedIn() && request.auth.uid == uid;
      // All mutations run through bounded callables. Rules alone cannot cap a
      // subcollection's document count, while the callable enforces the
      // product's 30-Circle account maximum.
      allow create, update, delete: if false;
    }

    // Legacy shared Circle docs are no longer used. Their client access is
    // sealed so historic group membership cannot leak into the new model.
    match /circles/{circleId} {
      function validCircle(data) {
        return data.keys().hasOnly([
            'name', 'emoji', 'ownerId', 'memberIds', 'members', 'createdAt'
          ])
          && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
          && (!('emoji' in data) || (data.emoji is string && data.emoji.size() <= 8))
          && data.ownerId is string
          && data.memberIds is list
          && data.memberIds.size() >= 1 && data.memberIds.size() <= 50
          && data.members is list && data.members.size() <= 50;
      }

      allow read, create, update, delete: if false;
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.blockerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow read, write: if false;
    }

    // ---------- activities/{activityId} ----------
    // Visible only to the denormalized audience. Host-only mutations.
    match /activities/{activityId} {
      function validActivity(data) {
        return data.keys().hasOnly([
            'hostId', 'mode', 'title', 'note', 'audienceUids', 'circleIds',
            'startsAt', 'endsAt', 'visibleUntil', 'expireAt', 'place', 'maxParticipants',
            'category', 'participants', 'participantUids', 'status', 'createdAt',
            'journeyReminderSentAt', 'journeyUnderwayCount', 'guestInvitesEnabled'
          ])
          && data.hostId is string
          && data.mode in ['open', 'soon', 'now']
          && data.title is string && data.title.size() >= 1 && data.title.size() <= 60
          && (!('note' in data) || (data.note is string && data.note.size() <= 500))
          && data.audienceUids is list && data.audienceUids.size() >= 1
              && data.audienceUids.size() <= 201
          && data.participantUids is list && data.participantUids.size() >= 1
              && data.participantUids.size() <= 50
          && data.participants is list && data.participants.size() >= 1
              && data.participants.size() <= 50
          && data.participants.size() == data.participantUids.size()
          && data.participantUids[0] == data.hostId
          && data.participants[0].uid == data.hostId
          && data.participants[0].displayName is string
          && data.participants[0].displayName.size() <= 50
          && data.participants[0].initials is string
          && data.participants[0].initials.size() <= 8
          && data.createdAt is timestamp
          && data.visibleUntil is timestamp
          && data.expireAt is timestamp
          && (!('journeyReminderSentAt' in data) || data.journeyReminderSentAt is timestamp)
          && (!('guestInvitesEnabled' in data) || data.guestInvitesEnabled == true)
          && (!('journeyUnderwayCount' in data)
              || (data.journeyUnderwayCount is int
                  && data.journeyUnderwayCount >= 0 && data.journeyUnderwayCount <= 50))
          && (!('startsAt' in data) || data.startsAt is string)
          && (!('endsAt' in data) || data.endsAt is string)
          && (!('maxParticipants' in data)
              || (data.maxParticipants is int
                  && data.maxParticipants >= 2 && data.maxParticipants <= 50))
          && (!('circleIds' in data) || (data.circleIds is list && data.circleIds.size() <= 20))
          && (!('category' in data)
              || data.category in ['essen', 'drinks', 'kaffee', 'sport',
                                   'outdoor', 'feiern', 'kultur', 'spiele',
                                   'lernen', 'chillen', 'shopping',
                                   'sonstiges'])
          && data.status in ['active', 'expired', 'cancelled']
          && (!('place' in data) || (
            data.place is map
            && data.place.keys().hasOnly(['label', 'latitude', 'longitude', 'visibility'])
            && data.place.label is string && data.place.label.size() <= 200
            && (
              (data.place.visibility == 'pin'
               && 'latitude' in data.place && 'longitude' in data.place
               && data.place.latitude is number && data.place.latitude >= -90
               && data.place.latitude <= 90
               && data.place.longitude is number && data.place.longitude >= -180
               && data.place.longitude <= 180)
              ||
              (data.place.visibility == 'none'
               && !('latitude' in data.place)
               && !('longitude' in data.place))
            )
          ));
      }

      // Read rules must stay PROVABLE for list queries: conditions like
      // `expireAt > request.time` compare resource fields against server
      // evaluation time, which no client query filter (client clock) can prove
      // — the rules engine then denies EVERY list/listener silently. Freshness
      // is enforced by the queries' own expireAt filters + client filtering +
      // the TTL policy; this rule only guards the privacy boundary.
      allow read: if signedIn()
        && request.auth.uid in resource.data.audienceUids
        && resource.data.status == 'active';
      // Activity creation is callable-function only. The function resolves
      // audienceUids from confirmed direct friends and creates the host member.
      allow create: if false;
      // Every mutation is callable-only: time changes have to move Activity
      // and chat retention together, and cancellation also revokes live
      // journey access. Direct client writes could leave those lifecycles out
      // of sync.
      allow update: if false;
      allow delete: if false; // TTL via expireAt

      // Server-only idempotency state for the location-free journey count.
      // Participants read actual live positions exclusively from RTDB.
      match /journeyStates/{uid} {
        allow read, write: if false;
      }
    }

    // ---------- timePlans/{planId} ----------
    // A time plan is deliberately not an Activity: it has no marker, no chat
    // and no fixed date until the host later locks one. Invitations stay
    // server-private; only people who joined may read availability.
    match /timePlans/{planId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create, update, delete: if false;

      match /timePlanMembers/{uid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/timePlans/$(planId)).data.memberUids;
        allow create, update, delete: if false;
      }
    }

    // Private server authorization for a notification invitation. A client
    // cannot enumerate invitees or turn a stale notification into membership.
    match /timePlanInvites/{inviteId} {
      allow read, write: if false;
    }

    // ---------- presence/{uid} ----------
    // The user's own "I'm open" status. Readable only by the denormalized
    // audience (their friends). Writable/deletable ONLY by the owner — going
    // private rewrites the doc without coarseLocation; going offline deletes it
    // (immediate, not TTL). expireAt drives the TTL policy as a backstop.
    match /presence/{uid} {
      function validPresence(data) {
        return data.keys().hasOnly([
            'uid', 'displayName', 'initials', 'avatarUrl', 'vibe',
            'expireAt', 'shareLocation', 'coarseLocation', 'audienceUids', 'updatedAt'
          ])
          && data.uid == uid
          && data.displayName is string && data.displayName.size() <= 50
          && data.initials is string && data.initials.size() <= 8
          && data.shareLocation is bool
          && (!('expireAt' in data)
              || (data.expireAt is timestamp && data.expireAt > request.time))
          && data.audienceUids is list && data.audienceUids.size() <= 50
          && (!('vibe' in data)
              || (data.vibe.label is string && data.vibe.label.size() <= 40))
          && (
            (!data.shareLocation && !('coarseLocation' in data))
            || (data.shareLocation && (!('coarseLocation' in data)
                || (data.coarseLocation is map
                    && data.coarseLocation.keys().hasOnly(['lat', 'lng'])
                    && data.coarseLocation.lat is number
                    && data.coarseLocation.lat >= -90
                    && data.coarseLocation.lat <= 90
                    && data.coarseLocation.lng is number
                    && data.coarseLocation.lng >= -180
                    && data.coarseLocation.lng <= 180)))
          );
      }

      allow read: if signedIn()
        && request.auth.uid in resource.data.audienceUids;
      // Presence is published through a callable so the server derives the
      // audience from accepted direct friendships. Clients may only clear their
      // own presence immediately.
      allow create, update: if false;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---------- groupOpenings/{roomId} ----------
    // Public TEASER for a planning group that opted into "Offen für
    // Dazustoßer": title/vibe/member preview only — NEVER messages. The
    // private room doc stays members-only; joining goes through the
    // joinOpenGroup callable which re-checks this audience.
    match /groupOpenings/{roomId} {
      // Provable-for-lists (see activities read rule).
      allow read: if signedIn()
        && request.auth.uid in resource.data.audienceUids
        && resource.data.status == 'active'
        && resource.data.expireAt > request.time;
      allow create, update, delete: if false; // setGroupJoinable callable only
    }

    // ---------- spontaneousRoundInvites / spontaneousRoundMemberships ----------
    // These are server-only race guards. An invitation reaches its intended
    // recipient through a private notification; clients never list or probe
    // pending invitees or another person's active-round state.
    match /spontaneousRoundInvites/{inviteId} {
      allow read, write: if false;
    }

    match /spontaneousRoundMemberships/{uid} {
      allow read, write: if false;
    }

    // ---------- groupChatInvites/{roomId}_{inviteeUid} ----------
    // A targeted planning-round invitation. Server-only for the same reason as
    // the round invites above: the invitee learns about it through their own
    // private notification, and nobody may probe who else was invited. Both
    // inviteToGroupChat and respondToGroupChatInvite are callables.
    match /groupChatInvites/{inviteId} {
      allow read, write: if false;
    }

    // ---------- notifications/{notificationId} ----------
    // Notification documents are immutable server projections. The account's
    // monotonic users/{uid}.notificationsSeenAt cursor records what was seen.
    match /notifications/{notificationId} {
      // Provable-for-lists (see activities read rule).
      allow read: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && resource.data.expireAt > request.time;
      allow create, update, delete: if false;
    }

    // ---------- chats/{roomId} ----------
    // A room is an activity chat or an open group. Members only.
    match /chats/{roomId} {
      function validRoom(data) {
        return data.keys().hasOnly([
            'type', 'title', 'vibe', 'creatorUid', 'memberIds', 'adminUids', 'joinable',
            'roundStatus', 'lastMessage', 'lastPushAt', 'messageCount', 'readCount', 'expireAt', 'createdAt'
          ])
          && (!('joinable' in data) || data.joinable is bool)
          && (!('roundStatus' in data) || data.roundStatus == 'forming')
          && data.type in ['activity', 'group']
          && (!('creatorUid' in data) || data.creatorUid is string)
          && data.memberIds is list
          && data.memberIds.size() >= 1 && data.memberIds.size() <= 50
          && (!('adminUids' in data)
              || (data.adminUids is list && data.adminUids.size() <= 50))
          && data.createdAt is timestamp
          && data.expireAt is timestamp
          && data.expireAt > request.time
          && data.messageCount is int && data.messageCount >= 0
          && data.readCount is map && data.readCount.keys().size() <= 50
          && (!('lastPushAt' in data) || data.lastPushAt is timestamp)
          && (!('title' in data) || (data.title is string && data.title.size() <= 80))
          && (!('vibe' in data) || (data.vibe is string && data.vibe.size() <= 60))
          && (!('lastMessage' in data) || (
            data.lastMessage is map
            && data.lastMessage.keys().hasOnly(['text', 'authorId', 'authorName', 'at'])
            && data.lastMessage.text is string && data.lastMessage.text.size() <= 2000
            && data.lastMessage.authorId is string
            && data.lastMessage.authorName is string
            && data.lastMessage.authorName.size() <= 50
            && data.lastMessage.at is timestamp
          ));
      }

      // Provable-for-lists (see activities read rule).
      allow read: if isMember(resource.data) && resource.data.expireAt > request.time;
      // Rooms are created by callable functions. This also ensures group
      // membership is derived from the caller's Circles on the server.
      allow create: if false;
      // Clients may only update their own read cursor. Message summaries and
      // messageCount are server-owned by the sendChatMessage callable.
      allow update: if signedIn()
        && validRoom(request.resource.data)
        && (
          (
            isMember(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readCount'])
            && request.resource.data.readCount.diff(resource.data.readCount)
                .affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.readCount.get(request.auth.uid, 0) is int
            && request.resource.data.readCount.get(request.auth.uid, 0)
                >= resource.data.readCount.get(request.auth.uid, 0)
            && request.resource.data.readCount.get(request.auth.uid, 0)
                <= request.resource.data.messageCount
          )
        );
      allow delete: if false; // TTL via expireAt

      // ---------- chats/{roomId}/messages/{messageId} ----------
      match /messages/{messageId} {
        function room() {
          return get(/databases/$(database)/documents/chats/$(roomId)).data;
        }
        function validMessage(data) {
          return data.keys().hasOnly([
              'authorId', 'authorName', 'initials', 'text', 'kind',
              'proposal', 'createdAt', 'expireAt'
            ])
            && data.authorId == request.auth.uid
            && data.authorName is string && data.authorName.size() <= 50
            && data.text is string && data.text.size() >= 1 && data.text.size() <= 2000
            && data.kind in ['text', 'proposal']
            && data.expireAt is timestamp
            && ((data.kind == 'proposal' && 'proposal' in data)
                || (data.kind == 'text' && !('proposal' in data)))
            && (!('proposal' in data) || (
              data.proposal is map
              && data.proposal.keys().hasOnly(['what', 'when', 'where', 'confirmedBy', 'planned'])
              && data.proposal.confirmedBy is list
              && data.proposal.confirmedBy.size() >= 1
              && data.proposal.confirmedBy.size() <= 25
              && (!('what' in data.proposal) ||
                  (data.proposal.what is string && data.proposal.what.size() <= 200))
              && (!('when' in data.proposal) ||
                  (data.proposal.when is string && data.proposal.when.size() <= 200))
              && (!('where' in data.proposal) ||
                  (data.proposal.where is string && data.proposal.where.size() <= 200))
              && (!('planned' in data.proposal) || data.proposal.planned is bool)
            ))
            && data.createdAt is timestamp;
        }
        // Mirrors the chats/{roomId} self-join idiom above: confirmedBy may only
        // grow or shrink by exactly the caller's own uid — never an arbitrary
        // rewrite — and is capped like the room's own memberIds.
        function confirmedByOk() {
          return !request.resource.data.proposal.diff(resource.data.proposal)
                   .affectedKeys().hasAny(['confirmedBy'])
            || (
              request.resource.data.proposal.confirmedBy.size() <= 50
              && (
                (request.resource.data.proposal.confirmedBy
                    .hasAll(resource.data.proposal.confirmedBy)
                  && request.resource.data.proposal.confirmedBy.size()
                      == resource.data.proposal.confirmedBy.size() + 1
                  && request.auth.uid in request.resource.data.proposal.confirmedBy)
                || (resource.data.proposal.confirmedBy
                      .hasAll(request.resource.data.proposal.confirmedBy)
                  && request.resource.data.proposal.confirmedBy.size()
                      == resource.data.proposal.confirmedBy.size() - 1
                  && request.auth.uid in resource.data.proposal.confirmedBy
                  && !(request.auth.uid in request.resource.data.proposal.confirmedBy))
              )
            );
        }

        allow read: if signedIn()
          && request.auth.uid in room().memberIds
          && room().expireAt > request.time;
        // Message creation is callable-function only. This keeps rate limits,
        // author fields and retention deadlines server-owned.
        allow create: if false;
        // Messages are immutable except proposal voting/locking:
        //  - anyone in the room may toggle ONLY their own uid in confirmedBy
        //  - any member may set planned: the "Aktivität" escalation button is
        //    deliberately offered to the whole group (core flow), so the lock
        //    must not be author-only — that silently failed for everyone else
        //    and allowed duplicate activities from one proposal.
        allow update: if signedIn()
          && request.auth.uid in room().memberIds
          && resource.data.kind == 'proposal'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proposal'])
          && request.resource.data.proposal.diff(resource.data.proposal)
               .affectedKeys().hasOnly(['confirmedBy', 'planned'])
          && confirmedByOk()
          && (
            !request.resource.data.proposal.diff(resource.data.proposal)
              .affectedKeys().hasAny(['planned'])
            || request.resource.data.proposal.planned is bool
          );
        allow delete: if false; // TTL via expireAt
      }
    }
  }
}
