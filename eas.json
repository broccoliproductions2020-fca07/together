{
  "cli": {
    "version": "22.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_FIREBASE_EMULATORS": "true",
        "EXPO_PUBLIC_CRASH_REPORTING_ENABLED": "false"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_FIREBASE_EMULATORS": "false",
        "EXPO_PUBLIC_FIREBASE_APP_CHECK_ENABLED": "true",
        "EXPO_PUBLIC_CRASH_REPORTING_ENABLED": "true",
        "EXPO_PUBLIC_STAGING_DIAGNOSTICS": "true",
        "EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED": "false",
        "EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED": "false"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "distribution": "store",
      "environment": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_FIREBASE_EMULATORS": "false",
        "EXPO_PUBLIC_FIREBASE_APP_CHECK_ENABLED": "true",
        "EXPO_PUBLIC_CRASH_REPORTING_ENABLED": "true",
        "EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED": "false",
        "EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
