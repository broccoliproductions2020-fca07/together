# Together — environment variables (example)
#
# Copy this file to `.env` and adjust. `.env` is git-ignored.
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# Restart `expo start` after changing values.

# --- Backend selection (see docs/backend-plan.md) ---
# mock     → fully offline, seeded data, no network (default, also without .env)
# firebase → Firebase SDK; by default against the LOCAL Emulator Suite
EXPO_PUBLIC_BACKEND=mock

# --- Firebase Emulator Suite (free, offline; start with `npm run emulators`) ---
# true (default) → firebase mode talks to the local emulators, never the cloud.
EXPO_PUBLIC_FIREBASE_EMULATORS=true
# Host of the machine running the emulators. Leave empty for auto-detection
# (localhost on web; the Expo dev-server IP on a physical device).
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# --- Real Firebase project (staging/release ONLY — not needed for emulators) ---
# Set `EXPO_PUBLIC_FIREBASE_EMULATORS=false`; the Firebase project identity is
# native and comes from firebase/native/google-services.json and
# firebase/native/GoogleService-Info.plist (both ignored by Git).

# Native Firebase hardening (only for a real cloud build, never for emulators).
# App Check is fail-closed in cloud mode once this is true. Configure App Attest
# (iOS) and Play Integrity (Android) in Firebase Console first.
EXPO_PUBLIC_FIREBASE_APP_CHECK_ENABLED=false
# Development/staging only: registered debug token for emulator/internal builds.
# Never set this in a production release environment.
EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN=

# --- Push notifications ---
# EAS project id used by Expo Notifications on physical devices.
EXPO_PUBLIC_EAS_PROJECT_ID=

# --- Google Maps SDK keys ("Option A": Google map on both platforms) ---
# Build-time only (injected via app.config.js), NOT bundled into JS.
# Restrict each key in the Google Cloud console to the app signature/bundle id.
# Without keys: Expo Go Android uses Expo's built-in key; iOS falls back to Apple Maps.
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

# --- Server-only Places search ---
# Put this in functions/.env for the Functions emulator or Cloud Functions.
# Never prefix it with EXPO_PUBLIC_ and never commit it.
GOOGLE_PLACES_API_KEY=

# --- Cloud Functions hardening (functions/.env only) ---
# Enable for staging/release after App Check is configured in the client.
# Keep false/unset for the local Emulator Suite.
# FUNCTIONS_ENFORCE_APP_CHECK=true

# Enable for staging/release once guest sign-in is blocked against real cloud
# projects (see USE_EMULATORS in src/shared/services/firebase.ts) — every
# remaining caller went through email/password sign-up and can verify.
# Keep false/unset for the local Emulator Suite: anonymous dev/test accounts
# have no email and would otherwise be locked out of every gated action.
# FUNCTIONS_ENFORCE_EMAIL_VERIFICATION=true
