# Together environment variables
# Copy this file to .env. The real .env is git-ignored.

# Local Firebase Emulator Suite (never points to the cloud)
EXPO_PUBLIC_FIREBASE_EMULATORS=true
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# App Check: false for the local emulator, true for staging/production.
# A debug token is development-only; never use it in staging or production.
EXPO_PUBLIC_FIREBASE_APP_CHECK_ENABLED=false
EXPO_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN=
EXPO_PUBLIC_CRASH_REPORTING_ENABLED=false

# EAS / push notifications
EXPO_PUBLIC_EAS_PROJECT_ID=

# Google Maps native SDK keys. Restrict the Android key to the signing
# certificate/package and the iOS key to its bundle identifier in Google Cloud.
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

# Firebase native files. Locally app.config.js uses firebase/native/<variant>/.
# In EAS, configure these as secret file variables for preview and production.
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICE_INFO_PLIST=

# Federated sign-in
EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=false
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Server-only variable: put this in functions/.env or Cloud Functions secret
# configuration. Never prefix it with EXPO_PUBLIC_ and never commit it.
GOOGLE_PLACES_API_KEY=
